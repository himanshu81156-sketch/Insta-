{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public user profile for Mera Insta (no PII).",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "bio": { "type": "string" },
        "avatarBase64": { "type": "string" },
        "isOnline": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "username", "displayName", "isOnline", "createdAt", "updatedAt"]
    },
    "FollowRelation": {
      "title": "FollowRelation",
      "description": "Directed follow relationship between two users.",
      "type": "object",
      "properties": {
        "followerId": { "type": "string" },
        "followingId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["followerId", "followingId", "createdAt"]
    },
    "BlockRelation": {
      "title": "BlockRelation",
      "description": "Directed block relationship between two users.",
      "type": "object",
      "properties": {
        "blockerId": { "type": "string" },
        "blockedId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["blockerId", "blockedId", "createdAt"]
    },
    "Post": {
      "title": "Post",
      "description": "Photo, Video, or Reel post.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "userAvatarBase64": { "type": "string" },
        "caption": { "type": "string" },
        "location": { "type": "string" },
        "taggedUsers": { "type": "string" },
        "filterName": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["photo", "video", "reel"] },
        "mediaBase64": { "type": "string" },
        "isReel": { "type": "boolean" },
        "musicName": { "type": "string" },
        "reelDurationSec": { "type": "integer" },
        "overlayText": { "type": "string" },
        "accentColorHex": { "type": "string" },
        "likesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "username", "mediaType", "isReel", "likesCount", "commentsCount", "createdAt", "updatedAt"]
    },
    "PostLike": {
      "title": "PostLike",
      "description": "Like on a post.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "username", "createdAt"]
    },
    "PostComment": {
      "title": "PostComment",
      "description": "Comment on a post.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "username", "text", "createdAt"]
    },
    "Story": {
      "title": "Story",
      "description": "24-hour ephemeral story.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "userAvatarBase64": { "type": "string" },
        "caption": { "type": "string" },
        "mediaBase64": { "type": "string" },
        "bgColorHex": { "type": "string" },
        "expiresAtMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "username", "expiresAtMillis", "createdAt"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "In-app notification for follows, likes, comments, and messages.",
      "type": "object",
      "properties": {
        "recipientId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderUsername": { "type": "string" },
        "type": { "type": "string", "enum": ["follow", "like", "comment", "message"] },
        "message": { "type": "string" },
        "postId": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientId", "senderId", "senderUsername", "type", "message", "isRead", "createdAt"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "Direct message conversation between two users.",
      "type": "object",
      "properties": {
        "participantIds": { "type": "array" },
        "lastMessage": { "type": "string" },
        "lastSenderId": { "type": "string" },
        "typingUserIds": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participantIds", "lastMessage", "lastSenderId", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual DM message (text, photo, video, voice).",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "recipientId": { "type": "string" },
        "participantIds": { "type": "array" },
        "type": { "type": "string", "enum": ["text", "photo", "video", "voice"] },
        "text": { "type": "string" },
        "mediaBase64": { "type": "string" },
        "voiceDurationSec": { "type": "integer" },
        "isSeen": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "recipientId", "participantIds", "type", "isSeen", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public user profiles."
    },
    "/follows/{followId}": {
      "schema": { "$ref": "#/entities/FollowRelation" },
      "description": "Follow relationships."
    },
    "/blocks/{blockId}": {
      "schema": { "$ref": "#/entities/BlockRelation" },
      "description": "User block relationships."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Feed posts and Reels."
    },
    "/posts/{postId}/likes/{likeUserId}": {
      "schema": { "$ref": "#/entities/PostLike" },
      "description": "Likes on a post."
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/PostComment" },
      "description": "Comments on a post."
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "#/entities/Story" },
      "description": "24-hour user stories."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/AppNotification" },
      "description": "User notifications."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatThread" },
      "description": "Direct message threads."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages inside a chat thread."
    }
  }
}
